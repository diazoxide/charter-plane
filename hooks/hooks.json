{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "charter workspace _reconcile >/dev/null 2>&1",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "charter persona _gc --detach"
          },
          {
            "type": "command",
            "command": "charter hook sessionstart --plugin-version 0.62.2",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "out=\"$(charter doctor --preflight 2>&1)\" || printf 'charter preflight failed - fix before working:\\n%s\\n' \"$out\"",
            "timeout": 20,
            "statusMessage": "charter preflight (charter doctor)"
          },
          {
            "type": "command",
            "command": "charter gl-refresh --detach"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "charter hook userpromptsubmit --plugin-version 0.62.2",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook pretooluse --plugin-version 0.62.2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook pretooluse-read --plugin-version 0.62.2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook pretooluse-dispatch --plugin-version 0.62.2"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook pretooluse-edit --plugin-version 0.62.2",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook posttooluse-bash --plugin-version 0.62.2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook posttooluse --plugin-version 0.62.2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook posttooluse-skill --plugin-version 0.62.2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook posttooluse-dispatch --plugin-version 0.62.2",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "charter hook posttooluse-message --plugin-version 0.62.2",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "charter hook stop --plugin-version 0.62.2",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "charter workspace _autosave >/dev/null 2>&1",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "charter workspace _autosave >/dev/null 2>&1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
